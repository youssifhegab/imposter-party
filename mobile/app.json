{
  "expo": {
    "name": "Imposter",
    "slug": "imposter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imposterparty.game"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4C1D95",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.imposterparty.game"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization"
    ],
    "scheme": "imposter",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "productionApiUrl": "https://imposter-party.fly.dev",
      "eas": {
        "projectId": "8fa76572-0654-4fd9-b236-2f43b6d4de54"
      }
    },
    "owner": "youssifhegab",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8fa76572-0654-4fd9-b236-2f43b6d4de54"
    }
  }
}
